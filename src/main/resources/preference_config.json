{
  "configs": [
    {
      "title": "NCM 转换",
      "config": "config.json",
      "preferences": [
        {
          "key": "ncm.auto",
          "type": "switch",
          "title": "自动监视下载目录",
          "summary": "启用后按间隔自动扫描，新下载的 NCM 会自动转换并归档",
          "default_value": true
        },
        {
          "key": "ncm.library",
          "type": "edittext",
          "title": "音乐库目录",
          "summary": "转换结果按 歌手/专辑 归档到这里，例如 D:\\music",
          "default_value": "D:\\music"
        },
        {
          "key": "ncm.source",
          "type": "edittext",
          "title": "下载目录（可选）",
          "summary": "留空 = 自动识别网易云下载目录；多个目录用英文分号 ; 分隔",
          "default_value": ""
        },
        {
          "key": "ncm.interval",
          "type": "seekbar",
          "title": "扫描间隔（秒）",
          "summary": "自动监视时的检查频率",
          "default_value": 60.0,
          "min": 10.0,
          "max": 600.0
        },
        {
          "key": "ncm.move_audio",
          "type": "switch",
          "title": "同时归档下载目录里的 FLAC/MP3",
          "summary": "关闭后只处理 NCM",
          "default_value": true
        },
        {
          "key": "ncm.lyrics",
          "type": "switch",
          "title": "转换后自动补歌词",
          "summary": "为刚转换的歌曲在线匹配歌词并保存 .lrc",
          "default_value": true
        },
        {
          "type": "button",
          "title": "立即处理一次",
          "summary": "扫描当前所有 NCM 并转换归档",
          "arrow_type": "none",
          "on_click": "io.github.spwncm.ncmhelper.MainPlugin.onRunNow"
        },
        {
          "type": "button",
          "title": "查看监视状态",
          "summary": "显示自动监视是否在运行",
          "arrow_type": "none",
          "on_click": "io.github.spwncm.ncmhelper.MainPlugin.onShowStatus"
        }
      ]
    },
    {
      "title": "歌词",
      "config": "config.json",
      "preferences": [
        {
          "key": "lyrics.online",
          "type": "switch",
          "title": "在线补全歌词",
          "summary": "播放器找不到歌词时，按歌名/歌手从网易云匹配（含翻译）",
          "default_value": true
        },
        {
          "key": "lyrics.write_lrc",
          "type": "switch",
          "title": "把歌词保存为 .lrc",
          "summary": "在音频同目录生成歌词文件，下次无需联网",
          "default_value": true
        }
      ]
    },
    {
      "title": "转换记录",
      "config": "config.json",
      "preferences": [
        {
          "key": "history.days",
          "type": "seekbar",
          "title": "保留天数",
          "summary": "超过该天数的转换记录会自动删除",
          "default_value": 30.0,
          "min": 1.0,
          "max": 3650.0
        },
        {
          "type": "button",
          "title": "打开转换记录",
          "summary": "用默认程序打开 history.jsonl",
          "arrow_type": "none",
          "on_click": "io.github.spwncm.ncmhelper.MainPlugin.onOpenHistory"
        },
        {
          "type": "button",
          "title": "清空转换记录",
          "summary": "删除全部历史记录",
          "arrow_type": "none",
          "on_click": "io.github.spwncm.ncmhelper.MainPlugin.onClearHistory"
        }
      ]
    },
    {
      "title": "网易云（实验）",
      "config": "config.json",
      "preferences": [
        {
          "key": "netease.enabled",
          "type": "switch",
          "title": "启用网易云功能",
          "summary": "实验性功能：扫码登录、搜索、歌单、我喜欢的音乐、下载。默认关闭，需自行登录",
          "default_value": false
        },
        {
          "type": "button",
          "title": "扫码登录",
          "summary": "生成登录二维码并打开，用网易云 App 扫码确认",
          "arrow_type": "none",
          "on_click": "io.github.spwncm.ncmhelper.MainPlugin.onNeteaseLogin"
        },
        {
          "type": "button",
          "title": "查看登录状态",
          "summary": "显示当前账号或未登录",
          "arrow_type": "none",
          "on_click": "io.github.spwncm.ncmhelper.MainPlugin.onNeteaseStatus"
        },
        {
          "type": "button",
          "title": "退出登录",
          "summary": "清除本地保存的登录 Cookie",
          "arrow_type": "none",
          "on_click": "io.github.spwncm.ncmhelper.MainPlugin.onNeteaseLogout"
        },
        {
          "key": "netease.playlist_id",
          "type": "edittext",
          "title": "歌单 ID",
          "summary": "歌单链接中的数字 ID，例如 3778678（热歌榜）",
          "default_value": ""
        },
        {
          "type": "button",
          "title": "下载歌单",
          "summary": "把歌单中可下载的歌曲保存到音乐库",
          "arrow_type": "none",
          "on_click": "io.github.spwncm.ncmhelper.MainPlugin.onDownloadPlaylist"
        },
        {
          "key": "netease.search_keyword",
          "type": "edittext",
          "title": "搜索关键词",
          "summary": "按关键词搜索并下载前几首可下载的歌曲",
          "default_value": ""
        },
        {
          "type": "button",
          "title": "搜索并下载",
          "summary": "搜索结果前 N 首保存到音乐库",
          "arrow_type": "none",
          "on_click": "io.github.spwncm.ncmhelper.MainPlugin.onSearchDownload"
        },
        {
          "type": "button",
          "title": "下载我喜欢的音乐",
          "summary": "把「我喜欢的音乐」前 N 首保存到音乐库",
          "arrow_type": "none",
          "on_click": "io.github.spwncm.ncmhelper.MainPlugin.onDownloadLikes"
        },
        {
          "key": "netease.limit",
          "type": "seekbar",
          "title": "每次最多下载（首）",
          "default_value": 10.0,
          "min": 1.0,
          "max": 50.0
        }
      ]
    }
  ]
}